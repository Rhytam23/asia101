# MEKONG SMART LAND SYSTEM — Environment Configuration
# Copy this file to .env.local and adjust as needed

# === Public Data APIs (no keys required for basic usage) ===
VITE_OPENMETEO_BASE=https://api.open-meteo.com/v1
VITE_SOILGRIDS_BASE=https://rest.isric.org/soilgrids/v2.0
VITE_NOMINATIM_BASE=https://nominatim.openstreetmap.org

# === Optional: Force Demo Mode (useful for presentations) ===
VITE_FORCE_DEMO_MODE=false

# === Future / Production (when backend is added) ===
# VITE_API_BASE_URL=https://api.mekong-smart-land.vn
# VITE_SMS_GATEWAY=vnpt
# VITE_GEE_PROJECT_ID=your-gee-project

# === Analytics / Monitoring (optional) ===
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=

# Note: All live services gracefully fall back to demonstration data.
# No secrets should ever be committed.